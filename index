// ══════════════════════════════════════════════
// SEGMENT DETECTION (audio energy simulation)
// ══════════════════════════════════════════════
function computeSegments(duration, nClips, maxLen) {
  const minLen = 20;
  const segs = [];
  const used = [];

  // Generate energy curve
  const resolution = 0.5;
  const nWindows = Math.floor(duration / resolution);
  const energy = [];
  for (let i = 0; i < nWindows; i++) {
    const t = i / nWindows;
    const base = 0.35 + 0.2 * Math.sin(t * Math.PI * 3);
    const noise = Math.random() * 0.25;
    const spike = (i % Math.floor(nWindows / (nClips + 1)) < 6) ? Math.random() * 0.35 : 0;
    energy.push(Math.min(1, base + noise + spike));
  }

  // Find peaks
  const peaks = [];
  for (let i = 2; i < nWindows - 2; i++) {
    if (energy[i] > energy[i-1] && energy[i] > energy[i+1] &&
        energy[i] > energy[i-2] && energy[i] > energy[i+2]) {
      peaks.push({ t: i * resolution, e: energy[i] });
    }
  }
  peaks.sort((a, b) => b.e - a.e);

  // Fallback: even distribution
  if (peaks.length < nClips) {
    const step = duration / (nClips + 1);
    for (let k = 1; k <= nClips; k++) {
      const t = k * step;
      const ei = Math.min(nWindows - 1, Math.floor(t / resolution));
      peaks.push({ t, e: energy[ei] || 0.5 });
    }
    peaks.sort((a, b) => b.e - a.e);
  }

  for (const peak of peaks) {
    if (segs.length >= nClips) break;
    const clipLen = Math.round(minLen + (maxLen - minLen) * peak.e);
    let start = Math.max(0, peak.t - clipLen * 0.3);
    let end = Math.min(duration, start + clipLen);
    start = Math.max(0, end - clipLen);

    // Check overlap
    const overlaps = used.some(([s, e]) => !(end < s - 10 || start > e + 10));
    if (overlaps) continue;

    segs.push({ start: Math.round(start * 10) / 10, end: Math.round(end * 10) / 10, energy: peak.e });
    used.push([start, end]);
  }

  segs.sort((a, b) => a.start - b.start);
  return segs;
}

function scoreSegment(energy, posRatio, idx, total) {
  const base = 50 + energy * 44;
  const posBonus = Math.max(0, 10 - Math.abs(posRatio - 0.4) * 18);
  const rankBonus = Math.max(0, (total - idx) / total * 7);
  return Math.min(99, Math.round(base + posBonus + rankBonus));
}

function genSubtitles(start, end, idx) {
  const dur = end - start;
  const tpl = SUB_TEMPLATES[idx % SUB_TEMPLATES.length];
  const tpl2 = SUB_TEMPLATES[(idx + 2) % SUB_TEMPLATES.length];
  const lines = [...tpl.slice(0, 3), ...tpl2.slice(0, 2)];
  const perLine = dur / lines.length;
  return lines.map((text, i) => ({
    time: fmtTime(i * perLine),
    text,
    startSec: parseFloat((i * perLine).toFixed(2)),
    endSec: parseFloat(Math.min((i + 1) * perLine, dur).toFixed(2))
  }));
}

// ══════════════════════════════════════════════
// RENDER CLIPS
// ══════════════════════════════════════════════
const GRADIENTS = [
  'linear-gradient(160deg,#1a0a2e,#2d1b4e)',
  'linear-gradient(160deg,#0a1628,#1a2d5e)',
  'linear-gradient(160deg,#0f1a0a,#1a3a10)',
  'linear-gradient(160deg,#1a0a0a,#3a1010)',
  'linear-gradient(160deg,#0a0a1a,#181050)',
  'linear-gradient(160deg,#1a1a0a,#3a3010)',
  'linear-gradient(160deg,#0a1a1a,#0a3a3a)',
  'linear-gradient(160deg,#1a0a14,#3a1030)',
];

function renderClips(clips) {
  const grid = document.getElementById('clipsGrid');
  if (!clips.length) {
    grid.innerHTML = `<div class="empty"><div class="empty-ico">✦</div><div class="empty-title">No clips generated</div><div class="empty-sub">Try adjusting clip count or max length</div></div>`;
    return;
  }

  grid.innerHTML = clips.map((c, i) => {
    const sc = c.score >= 95 ? '#34d399' : c.score >= 88 ? '#fbbf24' : '#f472b6';
    const tags = c.tags.map(t => `<span class="tag tag-${t}">${t}</span>`).join('');
    const plats = (c.platforms||[]).map(p =>
      p === 'yt' ? '<span class="pb pb-yt">YT</span>' : '<span class="pb pb-ig">IG</span>'
    ).join('');
    const grad = GRADIENTS[i % GRADIENTS.length];
    const hasVideo = !!c.clipUrl;

    return `
    <div class="card" id="card${c.id}" onclick="selectClip(${i})">
      <div class="thumb">
        ${hasVideo
          ? `<video class="thumb-video" src="${c.clipUrl}" muted loop preload="metadata"></video>`
          : `<div class="thumb-bg" style="background:${grad}"><div style="font-size:26px">🎬</div><div>${c.start}–${c.end}</div></div>`
        }
        <div class="plat-badges">${plats}</div>
        <div class="score-pill"><span style="color:${sc}">●</span>${c.score}</div>
        <div class="thumb-overlay">
          <button class="play-mini" onclick="event.stopPropagation();previewClip(${i})">▶</button>
        </div>
      </div>
      <div class="card-info">
        <div class="card-title" title="${c.title}">${c.title}</div>
        <div class="card-meta">
          <span class="dur-pill">${c.duration}</span>
          <span>${c.sentiment}</span>
        </div>
        <div class="tags">${tags}</div>
      </div>
      <div class="card-actions">
        <button class="ca-btn dl" onclick="event.stopPropagation();downloadClip(${i})" ${!hasVideo ? 'disabled title="Processing..."' : ''}>⬇ Download</button>
        <button class="ca-btn" onclick="event.stopPropagation();selectClip(${i})">✎ Edit</button>
      </div>
    </div>`;
  }).join('');
}

// ══════════════════════════════════════════════
// SELECT + PREVIEW
// ══════════════════════════════════════════════
function selectClip(idx) {
  document.querySelectorAll('.card').forEach(c => c.classList.remove('sel'));
  const card = document.getElementById('card' + S.clips[idx]?.id);
  if (card) card.classList.add('sel');
  S.selected = S.clips[idx];
  if (!S.selected) return;
  updatePhonePreview(S.selected);
  renderSubs(S.selected);
  renderImgs(S.selected);
}

function updatePhonePreview(clip) {
  const area = document.getElementById('phoneArea');
  const grad = GRADIENTS[(clip.id - 1) % GRADIENTS.length];

  if (clip.clipUrl) {
    area.innerHTML = `
      <video class="phone-preview-video" src="${clip.clipUrl}" muted loop playsinline></video>
      <button class="phone-play-btn" id="phonePBtn" onclick="togglePhonePlay()">▶</button>
      <div class="phone-sub-bar" id="phoneSub">${clip.subtitles[0]?.text || ''}</div>
    `;
    startSubCycle(clip);
  } else {
    area.innerHTML = `
      <div style="background:${grad};width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px">
        <div style="font-size:24px">🎬</div>
        <div style="font-size:10px;color:rgba(255,255,255,.4)">${clip.start}–${clip.end}</div>
      </div>
      <div class="phone-sub-bar" id="phoneSub">${clip.subtitles[0]?.text || ''}</div>
    `;
    startSubCycle(clip);
  }
}

let subTimer = null;
function startSubCycle(clip) {
  clearInterval(subTimer);
  let idx = 0;
  subTimer = setInterval(() => {
    if (!clip.subtitles?.length) return;
    idx = (idx + 1) % clip.subtitles.length;
    const el = document.getElementById('phoneSub');
    if (el) {
      el.style.opacity = '0';
      setTimeout(() => { el.textContent = clip.subtitles[idx]?.text || ''; el.style.opacity = '1'; }, 200);
    }
  }, 2400);
}

function togglePhonePlay() {
  const vid = document.querySelector('.phone-preview-video');
  const btn = document.getElementById('phonePBtn');
  if (!vid) return;
  if (vid.paused) { vid.play(); btn.textContent = '⏸'; }
  else { vid.pause(); btn.textContent = '▶'; }
}

function previewClip(idx) { selectClip(idx); }

function renderSubs(clip) {
  document.getElementById('subEditor').style.display = 'block';
  document.getElementById('subLines').innerHTML = clip.subtitles.map((s, i) => `
    <div class="sub-line ${i === 0 ? 'act' : ''}" onclick="activateSub(this)">
      <div class="sub-time">${s.time}</div>
      <div class="sub-text">${s.text}</div>
    </div>
  `).join('');
}

function activateSub(el) {
  document.querySelectorAll('.sub-line').forEach(s => s.classList.remove('act'));
  el.classList.add('act');
}

function renderImgs(clip) {
  document.getElementById('aiImgSec').style.display = 'block';
  const IMG_COLORS = [['#1a0a2e','#7c5cfc'],['#0a1628','#38bdf8'],['#0f1a0a','#34d399'],['#1a0a0a','#f472b6']];
  document.getElementById('imgGrid').innerHTML = clip.imgPrompts.map((p, i) => {
    const [bg, ac] = IMG_COLORS[i % IMG_COLORS.length];
    return `
      <div class="img-item ${i === 0 ? 'sel' : ''}" onclick="selImg(this)">
        <div class="img-placeholder" style="background:${bg}">
          <div style="font-size:18px">🎨</div>
          <div style="font-size:8px;color:${ac}">${p}</div>
        </div>
        <div class="img-label">${p.split(' ').slice(0, 3).join(' ')}</div>
      </div>`;
  }).join('');
}

function selImg(el) {
  document.querySelectorAll('.img-item').forEach(i => i.classList.remove('sel'));
  el.classList.add('sel');
}

async function regenImages() {
  if (!S.selected) return;
  toast('Regenerating AI images...');
  await sleep(1200);
  renderImgs(S.selected);
  toast('New images generated!');
}

// ══════════════════════════════════════════════
// DOWNLOAD
// ══════════════════════════════════════════════
function downloadClip(idx) {
  const clip = S.clips[idx];
  if (!clip || !clip.clipUrl) { toast('Clip not ready yet', true); return; }
  const ext = clip.clipBlob?.type === 'video/webm' ? '.webm' :
              clip.clipBlob?.type.includes('webm') ? '.webm' : '.mp4';
  const a = document.createElement('a');
  a.href = clip.clipUrl;
  a.download = `clipai_short_${String(clip.id).padStart(2,'0')}_${clip.score}score${ext}`;
  a.click();
  toast(`Downloading "${clip.title.slice(0, 30)}..."`);
}

function exportAll() {
  const ready = S.clips.filter(c => c.clipUrl);
  if (!ready.length) { toast('No clips ready to export', true); return; }
  let i = 0;
  const dl = () => {
    if (i >= ready.length) { toast(`Exported ${ready.length} clips!`); return; }
    downloadClip(S.clips.indexOf(ready[i]));
    i++;
    setTimeout(dl, 800);
  };
  dl();
}

function sortClips(val) {
  if (!S.clips.length) return;
  const sorted = [...S.clips].sort((a, b) => {
    if (val === 'score') return b.score - a.score;
    if (val === 'duration') return b.durationSec - a.durationSec;
    return a.id - b.id;
  });
  renderClips(sorted);
  if (S.selected) {
    const card = document.getElementById('card' + S.selected.id);
    if (card) card.classList.add('sel');
  }
}

// ══════════════════════════════════════════════
// UTILITIES
// ══════════════════════════════════════════════
function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

function toast(msg, isErr = false) {
  document.querySelectorAll('.toast').forEach(t => t.remove());
  const el = document.createElement('div');
  el.className = 'toast';
  el.style.borderColor = isErr ? 'rgba(244,67,54,.4)' : 'rgba(124,92,252,.35)';
  el.innerHTML = `<span style="color:${isErr ? '#f43f5e' : '#7c5cfc'}">✦</span> ${msg}`;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3800);
}
</script>
