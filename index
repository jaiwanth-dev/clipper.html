<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ClipAI Studio — AI Video Clipper</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600&display=swap');
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#08080f;--s1:#111119;--s2:#18181f;--s3:#22222a;
  --b1:rgba(255,255,255,0.07);--b2:rgba(255,255,255,0.13);--b3:rgba(255,255,255,0.22);
  --acc:#7c5cfc;--acc2:#c084fc;--acc3:#34d399;--acc4:#f472b6;--amb:#fbbf24;
  --tx:#ede9ff;--tx2:#9b91c8;--tx3:#4e4870;
  --red:#f43f5e;--teal:#2dd4bf;
}
html,body{height:100%;background:var(--bg);color:var(--tx);font-family:'DM Sans',sans-serif;overflow:hidden}

/* ── LAYOUT ── */
.app{display:grid;grid-template-rows:56px 1fr;height:100vh}
.topbar{
  background:var(--s1);border-bottom:1px solid var(--b1);
  display:flex;align-items:center;padding:0 20px;gap:14px;z-index:50;
}
.logo{font-family:'Syne',sans-serif;font-weight:800;font-size:22px;letter-spacing:-0.5px}
.logo-c{background:linear-gradient(135deg,var(--acc),var(--acc2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.logo-ai{-webkit-text-fill-color:var(--acc3)}
.topbar-right{margin-left:auto;display:flex;align-items:center;gap:8px}

.workspace{display:grid;grid-template-columns:320px 1fr 280px;overflow:hidden;height:100%}

/* ── PANELS ── */
.panel{background:var(--s1);overflow-y:auto;display:flex;flex-direction:column}
.panel-l{border-right:1px solid var(--b1)}
.panel-r{border-left:1px solid var(--b1)}
.sec{padding:14px 16px;border-bottom:1px solid var(--b1)}
.sec-title{font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:var(--tx3);margin-bottom:11px}

/* ── UPLOAD ── */
.drop-zone{
  border:1.5px dashed var(--b2);border-radius:12px;padding:22px 14px;
  text-align:center;cursor:pointer;transition:.2s;position:relative;overflow:hidden;
}
.drop-zone:hover,.drop-zone.drag{border-color:var(--acc);background:rgba(124,92,252,.06)}
.drop-zone.ready{border-color:var(--acc3);background:rgba(52,211,153,.05)}
.drop-zone input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer}
.dz-icon{font-size:30px;margin-bottom:6px}
.dz-title{font-size:14px;font-weight:500;margin-bottom:3px}
.dz-sub{font-size:12px;color:var(--tx2)}
.dz-file{font-size:12px;color:var(--acc3);font-weight:600;margin-top:5px;word-break:break-all}

/* ── SETTINGS ── */
.row{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.row:last-child{margin-bottom:0}
.lbl{font-size:13px;color:var(--tx2)}
.val{font-size:13px;font-weight:500}
select{
  background:var(--s2);border:1px solid var(--b2);color:var(--tx);
  border-radius:7px;padding:5px 9px;font-size:12px;font-family:'DM Sans',sans-serif;cursor:pointer;
}
select:focus{outline:none;border-color:var(--acc)}
input[type=range]{
  -webkit-appearance:none;background:var(--s3);border:none;height:4px;border-radius:4px;
  width:90px;cursor:pointer;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:14px;height:14px;background:var(--acc);border-radius:50%;
}
.toggle{position:relative;width:38px;height:21px;cursor:pointer;flex-shrink:0}
.toggle input{opacity:0;width:0;height:0}
.tslider{
  position:absolute;inset:0;background:var(--s3);border-radius:21px;
  transition:.25s;border:1px solid var(--b2);
}
.tslider:before{
  content:'';position:absolute;width:15px;height:15px;border-radius:50%;
  background:var(--tx3);top:2px;left:2px;transition:.25s;
}
.toggle input:checked+.tslider{background:var(--acc);border-color:var(--acc)}
.toggle input:checked+.tslider:before{transform:translateX(17px);background:#fff}

/* ── WAVEFORM ── */
#waveform{border-radius:8px;width:100%}

/* ── ANALYZE BTN ── */
.abtn{
  width:100%;padding:11px;border:none;border-radius:10px;cursor:pointer;
  background:linear-gradient(135deg,var(--acc),#9b5de5);color:#fff;
  font-size:14px;font-weight:600;font-family:'DM Sans',sans-serif;
  display:flex;align-items:center;justify-content:center;gap:8px;
  transition:.2s;position:relative;overflow:hidden;
}
.abtn:hover:not(:disabled){transform:translateY(-1px);box-shadow:0 8px 24px rgba(124,92,252,.35)}
.abtn:disabled{opacity:.45;cursor:not-allowed;transform:none !important;box-shadow:none !important}
.shimmer{
  position:absolute;top:0;left:-100%;width:100%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.13),transparent);
  animation:sh 1.6s infinite;
}
@keyframes sh{to{left:100%}}

/* ── CENTER ── */
.center-panel{display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}
.clips-hdr{
  padding:14px 18px 11px;display:flex;align-items:center;gap:10px;
  border-bottom:1px solid var(--b1);background:var(--s1);flex-shrink:0;
}
.clips-hdr-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700}
.badge{font-size:11px;background:var(--s2);color:var(--tx2);padding:3px 9px;border-radius:20px;border:1px solid var(--b1)}
.clips-grid{flex:1;overflow-y:auto;padding:14px 16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;align-content:start}

/* ── CLIP CARD ── */
.card{
  background:var(--s1);border:1px solid var(--b1);border-radius:13px;
  overflow:hidden;cursor:pointer;transition:.2s;
}
.card:hover{border-color:var(--b2);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.4)}
.card.sel{border-color:var(--acc);box-shadow:0 0 0 2px rgba(124,92,252,.22)}
.thumb{width:100%;aspect-ratio:9/16;max-height:160px;position:relative;overflow:hidden;background:var(--s2)}
.thumb-bg{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:11px;color:rgba(255,255,255,.3)}
.thumb-video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.thumb-overlay{
  position:absolute;inset:0;background:linear-gradient(to bottom,transparent 40%,rgba(0,0,0,.8));
  opacity:0;transition:.2s;display:flex;align-items:flex-end;justify-content:center;padding-bottom:10px;
}
.card:hover .thumb-overlay{opacity:1}
.play-mini{
  width:34px;height:34px;border-radius:50%;background:#fff;border:none;
  cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;
  transition:.15s;
}
.play-mini:hover{transform:scale(1.1)}
.score-pill{
  position:absolute;top:7px;right:7px;background:rgba(0,0,0,.7);
  border-radius:20px;padding:2px 7px;font-size:10px;font-weight:700;
  display:flex;align-items:center;gap:3px;
}
.plat-badges{position:absolute;top:7px;left:7px;display:flex;flex-direction:column;gap:3px}
.pb{font-size:8px;font-weight:700;padding:2px 5px;border-radius:3px;text-transform:uppercase}
.pb-yt{background:rgba(255,0,0,.85);color:#fff}
.pb-ig{background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);color:#fff}
.card-info{padding:9px 11px}
.card-title{font-size:13px;font-weight:500;margin-bottom:4px;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-meta{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--tx2);margin-bottom:7px}
.dur-pill{background:var(--s3);padding:2px 6px;border-radius:4px;font-weight:500}
.tags{display:flex;flex-wrap:wrap;gap:3px}
.tag{font-size:10px;padding:2px 7px;border-radius:20px;border:1px solid var(--b2);color:var(--tx2)}
.tag-viral{border-color:rgba(244,72,182,.4);color:var(--acc4)}
.tag-hook{border-color:rgba(251,191,36,.4);color:var(--amb)}
.tag-edu{border-color:rgba(45,212,191,.4);color:var(--teal)}
.card-actions{display:flex;gap:5px;padding:0 11px 9px}
.ca-btn{
  flex:1;padding:6px;border-radius:6px;border:1px solid var(--b2);
  background:transparent;color:var(--tx2);font-size:11px;font-weight:500;
  cursor:pointer;font-family:'DM Sans',sans-serif;transition:.15s;
  display:flex;align-items:center;justify-content:center;gap:3px;
}
.ca-btn:hover{background:var(--s2);color:var(--tx);border-color:var(--acc)}
.ca-btn.dl{background:rgba(52,211,153,.12);color:var(--acc3);border-color:rgba(52,211,153,.3)}
.ca-btn.dl:hover{background:rgba(52,211,153,.22)}
.ca-btn:disabled{opacity:.4;cursor:not-allowed}

/* ── EMPTY STATE ── */
.empty{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:50px 20px;text-align:center;gap:10px}
.empty-ico{width:68px;height:68px;border-radius:18px;background:var(--s2);border:1px solid var(--b1);display:flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:6px}
.empty-title{font-family:'Syne',sans-serif;font-size:17px;font-weight:700}
.empty-sub{font-size:13px;color:var(--tx2);max-width:260px;line-height:1.6}

/* ── RIGHT PANEL ── */
.phone-wrap{padding:14px}
.phone-frame{
  width:100%;max-width:190px;margin:0 auto;aspect-ratio:9/19;
  background:#000;border-radius:26px;border:2px solid var(--b2);
  position:relative;overflow:hidden;
}
.phone-notch{
  position:absolute;top:9px;left:50%;transform:translateX(-50%);
  width:55px;height:16px;background:var(--s1);border-radius:20px;z-index:10;
}
.phone-inner{width:100%;height:100%;display:flex;flex-direction:column;position:relative}
.phone-video-area{flex:1;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:6px;font-size:11px;color:var(--tx3);position:relative;overflow:hidden;background:#000}
.phone-preview-video{width:100%;height:100%;object-fit:cover;position:absolute;inset:0}
.phone-sub-bar{
  position:absolute;bottom:0;left:0;right:0;padding:8px 10px 10px;
  background:linear-gradient(to top,rgba(0,0,0,.9),transparent);
  font-size:13px;font-weight:700;text-align:center;color:#fff;
  text-shadow:0 1px 4px rgba(0,0,0,.9);min-height:48px;
  display:flex;align-items:flex-end;justify-content:center;
  transition:opacity .3s;
}
.phone-play-btn{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:50%;
  border:1px solid rgba(255,255,255,.2);cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:14px;transition:.2s;z-index:5;
}
.phone-play-btn:hover{background:rgba(255,255,255,.25)}

/* ── PROGRESS ── */
.prog-sec{padding:14px 16px;border-bottom:1px solid var(--b1)}
.prog-lbl{display:flex;justify-content:space-between;font-size:11px;color:var(--tx2);margin-bottom:7px}
.prog-track{height:5px;background:var(--s3);border-radius:20px;overflow:hidden;margin-bottom:10px}
.prog-fill{height:100%;border-radius:20px;background:linear-gradient(90deg,var(--acc),var(--acc2));transition:width .5s ease}
.prog-steps{display:flex;flex-direction:column;gap:5px}
.pstep{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--tx3)}
.pstep.done{color:var(--acc3)}
.pstep.active{color:var(--tx)}
.pdot{width:7px;height:7px;border-radius:50%;background:var(--s3);border:1px solid var(--b2);flex-shrink:0}
.pstep.done .pdot{background:var(--acc3);border-color:var(--acc3)}
.pstep.active .pdot{background:var(--acc);border-color:var(--acc);animation:pulse .9s infinite}
@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(124,92,252,.6)}50%{box-shadow:0 0 0 4px rgba(124,92,252,0)}}

/* ── SUBTITLE EDITOR ── */
.sub-editor{padding:14px 16px;border-bottom:1px solid var(--b1)}
.sub-line{
  background:var(--s2);border:1px solid var(--b1);border-radius:8px;
  padding:8px 11px;margin-bottom:7px;cursor:pointer;transition:border-color .15s;
}
.sub-line:last-child{margin-bottom:0}
.sub-line:hover,.sub-line.act{border-color:var(--acc)}
.sub-line.act{background:rgba(124,92,252,.06)}
.sub-time{font-size:9px;color:var(--acc);font-weight:700;margin-bottom:3px;font-family:'Syne',sans-serif}
.sub-text{font-size:12px;color:var(--tx);line-height:1.4}

/* ── AI IMAGES ── */
.ai-img-sec{padding:14px 16px}
.img-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px}
.img-item{
  aspect-ratio:1;border-radius:8px;background:var(--s2);border:1px solid var(--b1);
  overflow:hidden;cursor:pointer;position:relative;transition:.2s;
}
.img-item:hover{border-color:var(--acc);transform:scale(1.03)}
.img-item.sel{border-color:var(--acc);box-shadow:0 0 0 2px rgba(124,92,252,.25)}
.img-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:9px;gap:3px;padding:4px;text-align:center;color:rgba(255,255,255,.4)}
.img-label{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(0,0,0,.85),transparent);padding:14px 5px 5px;font-size:8px;color:rgba(255,255,255,.7);text-align:center}
.regen-btn{
  width:100%;margin-top:9px;padding:8px;background:rgba(52,211,153,.1);
  border:1px solid rgba(52,211,153,.22);border-radius:8px;color:var(--acc3);
  font-size:11px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;
  transition:.2s;display:flex;align-items:center;justify-content:center;gap:5px;
}
.regen-btn:hover{background:rgba(52,211,153,.18)}

/* ── TOPBAR BTNS ── */
.tbtn{
  padding:6px 14px;border-radius:7px;font-size:12px;font-weight:500;cursor:pointer;
  transition:.15s;color:var(--tx2);border:none;background:transparent;font-family:'DM Sans',sans-serif;
}
.tbtn.pri{background:linear-gradient(135deg,var(--acc),#9b5de5);color:#fff;padding:6px 16px}
.tbtn.pri:hover{opacity:.85}
.tbtn.sec{border:1px solid var(--b2);color:var(--tx)}
.tbtn.sec:hover{background:var(--s2)}

/* ── TOAST ── */
.toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
  background:var(--s2);border:1px solid rgba(124,92,252,.35);color:var(--tx);
  padding:11px 18px;border-radius:10px;font-size:12px;z-index:9999;
  white-space:nowrap;max-width:90vw;animation:tIn .25s ease;
  box-shadow:0 8px 24px rgba(0,0,0,.5);display:flex;align-items:center;gap:8px;
}
@keyframes tIn{from{opacity:0;transform:translateX(-50%) translateY(8px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}

/* ── MODAL ── */
.modal-bg{
  position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:200;
  display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);
}
.modal{
  background:var(--s1);border:1px solid var(--b2);border-radius:16px;
  padding:28px 32px;max-width:380px;width:90%;text-align:center;
}
.modal h2{font-family:'Syne',sans-serif;font-size:18px;font-weight:700;margin-bottom:8px}
.modal p{font-size:13px;color:var(--tx2);margin-bottom:18px;line-height:1.6}
.modal-spin{
  width:48px;height:48px;border-radius:50%;border:2px solid var(--s3);
  border-top-color:var(--acc);border-right-color:var(--acc2);
  animation:spin .75s linear infinite;margin:0 auto 14px;
}
@keyframes spin{to{transform:rotate(360deg)}}
.modal-prog{height:4px;background:var(--s3);border-radius:20px;overflow:hidden;margin-top:12px}
.modal-prog-fill{height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));border-radius:20px;transition:width .5s ease}

::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--s3);border-radius:4px}

.processing-clip-label{font-size:10px;color:var(--tx2);text-align:center;margin-top:6px}
</style>
</head>
<body>

<div class="app">

<!-- TOPBAR -->
<div class="topbar">
  <div class="logo"><span class="logo-c">Clip</span><span class="logo-ai">AI</span></div>
  <span style="font-size:12px;color:var(--tx3)">Studio</span>
  <div class="topbar-right">
    <button class="tbtn sec" id="exportAllBtn" onclick="exportAll()" disabled>⬇ Export All</button>
  </div>
</div>

<div class="workspace">

<!-- LEFT PANEL -->
<div class="panel panel-l">

  <div class="sec">
    <div class="sec-title">Source Video</div>
    <div class="drop-zone" id="dropZone">
      <input type="file" id="fileInput" accept="video/*" onchange="onFileSelect(this.files[0])">
      <div class="dz-icon">🎬</div>
      <div class="dz-title">Drop video or click to browse</div>
      <div class="dz-sub">MP4 · MOV · AVI · MKV · WebM — No size limit</div>
      <div class="dz-file" id="dzFile" style="display:none"></div>
    </div>
  </div>

  <div class="sec" id="vidInfoSec" style="display:none">
    <div class="sec-title">Video Info</div>
    <div class="row"><span class="lbl">Duration</span><span class="val" id="vi-dur">—</span></div>
    <div class="row"><span class="lbl">Resolution</span><span class="val" id="vi-res">—</span></div>
    <div class="row"><span class="lbl">File Size</span><span class="val" id="vi-size">—</span></div>
    <div class="row"><span class="lbl">Format</span><span class="val" id="vi-fmt">—</span></div>
  </div>

  <div class="sec">
    <div class="sec-title">Clip Settings</div>
    <div class="row">
      <span class="lbl">Platform</span>
      <select id="sel-platform">
        <option value="both">YT Shorts + Instagram</option>
        <option value="yt">YouTube Shorts only</option>
        <option value="ig">Instagram Reels only</option>
        <option value="tiktok">TikTok + All</option>
      </select>
    </div>
    <div class="row">
      <span class="lbl">Max clip length</span>
      <div style="display:flex;align-items:center;gap:7px">
        <input type="range" id="clip-len" min="15" max="60" value="45"
          oninput="document.getElementById('clip-len-val').textContent=this.value+'s'">
        <span class="val" id="clip-len-val">45s</span>
      </div>
    </div>
    <div class="row">
      <span class="lbl">Number of clips</span>
      <select id="sel-count">
        <option value="5">5 clips</option>
        <option value="10" selected>10 clips</option>
        <option value="15">15 clips</option>
        <option value="20">20 clips</option>
      </select>
    </div>
    <div class="row">
      <span class="lbl">Auto-captions</span>
      <label class="toggle"><input type="checkbox" id="tog-caps" checked><span class="tslider"></span></label>
    </div>
    <div class="row">
      <span class="lbl">Caption style</span>
      <select id="sel-capstyle">
        <option value="bold">Bold + Border</option>
        <option value="minimal">Clean minimal</option>
        <option value="karaoke">Word highlight</option>
      </select>
    </div>
    <div class="row">
      <span class="lbl">9:16 vertical crop</span>
      <label class="toggle"><input type="checkbox" id="tog-crop" checked><span class="tslider"></span></label>
    </div>
  </div>

  <div class="sec">
    <div class="sec-title">AI Analysis</div>
    <div class="row"><span class="lbl">Hook detection</span><label class="toggle"><input type="checkbox" checked><span class="tslider"></span></label></div>
    <div class="row"><span class="lbl">Energy peaks</span><label class="toggle"><input type="checkbox" checked><span class="tslider"></span></label></div>
    <div class="row"><span class="lbl">Virality scoring</span><label class="toggle"><input type="checkbox" checked><span class="tslider"></span></label></div>
  </div>

  <div class="sec">
    <div class="sec-title">Timeline</div>
    <canvas id="waveform" height="44"></canvas>
  </div>

  <div class="sec" style="border-bottom:none;padding-top:8px">
    <button class="abtn" id="analyzeBtn" onclick="startPipeline()" disabled>
      <span id="btnShimmer" class="shimmer" style="display:none"></span>
      <span id="btnIco">✦</span>
      <span id="btnTxt">Analyze & Generate Clips</span>
    </button>
  </div>

</div>

<!-- CENTER -->
<div class="center-panel">
  <div class="clips-hdr">
    <div class="clips-hdr-title">Generated Clips</div>
    <div class="badge" id="clipBadge">0 clips</div>
    <select class="tbtn sec" style="margin-left:auto;font-size:11px" id="sortSel" onchange="sortClips(this.value)">
      <option value="score">Sort by Virality</option>
      <option value="duration">Sort by Duration</option>
      <option value="order">Sort by Time</option>
    </select>
  </div>
  <div class="clips-grid" id="clipsGrid">
    <div class="empty">
      <div class="empty-ico">✦</div>
      <div class="empty-title">Ready to clip</div>
      <div class="empty-sub">Upload any video — no size limit. AI finds the best moments and exports vertical Shorts.</div>
    </div>
  </div>
</div>

<!-- RIGHT PANEL -->
