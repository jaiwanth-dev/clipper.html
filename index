  return new Promise((resolve, reject) => {
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/@ffmpeg/ffmpeg@0.12.6/dist/umd/ffmpeg.js';
    script.onload = async () => {
      try {
        const { FFmpeg } = window.FFmpegModule || window;
        if (!FFmpeg) { reject(new Error('FFmpeg not found on window')); return; }
        const ff = new FFmpeg();
        ff.on('log', ({ message }) => console.log('[FFmpeg]', message));
        await ff.load({
          coreURL: 'https://unpkg.com/@ffmpeg/core@0.12.4/dist/umd/ffmpeg-core.js',
        });
        S.ffmpeg = ff;
        S.ffmpegReady = true;
        resolve(true);
      } catch (e) { reject(e); }
    };
    script.onerror = () => reject(new Error('Script load failed'));
    document.head.appendChild(script);
    setTimeout(() => reject(new Error('Timeout')), 15000);
  });
}

// ══════════════════════════════════════════════
// CLIP EXTRACTION — FFmpeg.wasm (real processing)
// ══════════════════════════════════════════════
async function extractClipFFmpeg(file, startSec, endSec, subs, wantCaps, wantCrop, capStyle) {
  try {
    const ff = S.ffmpeg;
    const { fetchFile } = window.FFmpegModule || window;
    if (!fetchFile) throw new Error('fetchFile missing');

    const inName = 'input' + file.name.split('.').pop();
    const outName = 'clip_out.mp4';

    await ff.writeFile(inName, await fetchFile(file));

    const duration = endSec - startSec;
    const vfParts = [];

    if (wantCrop) {
      // 9:16 center crop
      vfParts.push('crop=ih*9/16:ih:(iw-ih*9/16)/2:0');
      vfParts.push('scale=1080:1920');
    } else {
      vfParts.push('scale=1080:1920:force_original_aspect_ratio=decrease');
      vfParts.push('pad=1080:1920:(ow-iw)/2:(oh-ih)/2:black');
    }

    if (wantCaps && subs) {
      subs.forEach(sub => {
        const t = sub.text.replace(/'/g, '').replace(/,/g, '').replace(/:/g, ' ');
        const ts = sub.startSec.toFixed(2), te = sub.endSec.toFixed(2);
        const enableStr = `between(t\\,${ts}\\,${te})`;
        if (capStyle === 'bold') {
          vfParts.push(`drawtext=text='${t}':fontcolor=white:fontsize=60:x=(w-text_w)/2:y=h*0.78-text_h/2:borderw=5:bordercolor=black:enable='${enableStr}'`);
        } else if (capStyle === 'minimal') {
          vfParts.push(`drawtext=text='${t}':fontcolor=white:fontsize=48:x=(w-text_w)/2:y=h*0.80-text_h/2:box=1:boxcolor=black@0.55:boxborderw=12:enable='${enableStr}'`);
        } else {
          // karaoke - just bold yellow
          vfParts.push(`drawtext=text='${t}':fontcolor=yellow:fontsize=56:x=(w-text_w)/2:y=h*0.78-text_h/2:borderw=4:bordercolor=black:enable='${enableStr}'`);
        }
      });
    }

    const vf = vfParts.join(',');

    const args = [
      '-ss', String(startSec),
      '-i', inName,
      '-t', String(duration),
      '-vf', vf,
      '-c:v', 'libx264',
      '-preset', 'ultrafast',
      '-crf', '26',
      '-c:a', 'aac',
      '-b:a', '128k',
      '-movflags', '+faststart',
      '-pix_fmt', 'yuv420p',
      outName
    ];

    await ff.exec(args);
    const data = await ff.readFile(outName);
    await ff.deleteFile(inName).catch(() => {});
    await ff.deleteFile(outName).catch(() => {});

    return new Blob([data.buffer], { type: 'video/mp4' });
  } catch (e) {
    console.warn('FFmpeg.wasm extraction failed:', e);
    return null;
  }
}

// ══════════════════════════════════════════════
// FALLBACK: slice original file segment
// ══════════════════════════════════════════════
async function extractClipFallback(file, startSec, endSec) {
  // Can't do real transcoding without FFmpeg, return a time-sliced blob
  // The browser will handle seeking via MediaSource on playback
  // For download, return a copy of the original file (user can trim manually)
  // OR use MediaRecorder to capture the playing video
  
  try {
    // Create a video element and capture the segment using MediaRecorder
    return await captureSegment(file, startSec, endSec);
  } catch(e) {
    console.warn('Fallback capture failed:', e);
    // Return the original file as last resort
    return new Blob([await file.arrayBuffer()], { type: file.type });
  }
}

async function captureSegment(file, startSec, endSec) {
  return new Promise((resolve, reject) => {
    const timeout = setTimeout(() => {
      vid.src = '';
      // Return original file portion as best effort
      resolve(file.slice(0, Math.min(file.size, 50 * 1024 * 1024)));
    }, 30000);

    const vid = document.createElement('video');
    vid.muted = true;
    vid.playsInline = true;
    vid.src = URL.createObjectURL(file);
    vid.style.cssText = 'position:fixed;opacity:0;width:1px;height:1px;top:-100px';
    document.body.appendChild(vid);

    const chunks = [];
    let recorder;

    vid.onloadedmetadata = () => {
      vid.currentTime = startSec;
    };

    vid.onseeked = () => {
      try {
        const stream = vid.captureStream ? vid.captureStream(30) : vid.mozCaptureStream(30);
        const mimeType = MediaRecorder.isTypeSupported('video/mp4') ? 'video/mp4' :
                        MediaRecorder.isTypeSupported('video/webm;codecs=vp9') ? 'video/webm;codecs=vp9' : 'video/webm';
        recorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 2500000 });
        recorder.ondataavailable = e => { if (e.data.size > 0) chunks.push(e.data); };
        recorder.onstop = () => {
          clearTimeout(timeout);
          URL.revokeObjectURL(vid.src);
          document.body.removeChild(vid);
          resolve(new Blob(chunks, { type: mimeType }));
        };
        recorder.start(100);
        vid.play();
      } catch(e) {
        clearTimeout(timeout);
        vid.src = '';
        document.body.removeChild(vid);
        resolve(file.slice(0, Math.min(file.size, 50 * 1024 * 1024)));
      }
    };

    vid.ontimeupdate = () => {
      if (vid.currentTime >= endSec && recorder && recorder.state === 'recording') {
        recorder.stop();
        vid.pause();
      }
    };

    vid.onerror = () => { clearTimeout(timeout); reject(new Error('Video error')); };
  });
}

