function drawWaveform(energyArr) {
  const canvas = document.getElementById('waveform');
  canvas.width = canvas.parentElement.clientWidth - 32;
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  ctx.clearRect(0, 0, W, H);
  const bars = 55, bw = W / bars - 1.2;
  for (let i = 0; i < bars; i++) {
    const e = energyArr ? energyArr[Math.floor(i * energyArr.length / bars)] : Math.random();
    const h = Math.max(4, e * 0.85 * H);
    const x = i * (bw + 1.2), y = (H - h) / 2;
    ctx.fillStyle = (e > 0.55) ? '#7c5cfc' : '#22222a';
    ctx.beginPath();
    ctx.roundRect(x, y, bw, h, 2);
    ctx.fill();
  }
}
drawWaveform(null);
